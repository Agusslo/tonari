# Connection string de MongoDB Atlas, con el nombre de la base (tonari) antes del "?"
MONGO_URI=mongodb+srv://USUARIO:CONTRASEÑA@CLUSTER.mongodb.net/tonari?retryWrites=true&w=majority

# URL del front: el back solo acepta pedidos de ahí (CORS). Varias, separadas por coma.
URL_FRONT=http://localhost:4200

# Secreto con el que el back firma los JWT
CONTRASENA_DEL_SERVER=CAMBIAR_POR_UN_TEXTO_LARGO

# Cloudinary (donde se guardan las imágenes): Dashboard -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
